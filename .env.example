# ==============================================
# INTELLIGENT SCRAPER - ENVIRONMENT VARIABLES
# ==============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ==============================================
# LLM CONFIGURATION
# ==============================================

# Primary LLM Provider (groq recommended)
LLM_PRIMARY_PROVIDER=groq

# Fallback LLM Provider (gemini recommended)
LLM_FALLBACK_PROVIDER=gemini

# Enable automatic fallback on primary provider failure
LLM_FALLBACK_ENABLED=true

# Groq API Configuration
# Get your key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
# Alternative models: openai/gpt-oss-20b, qwen/qwen3.8-27b

# Google Gemini API Configuration
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
# Alternative models: gemini-flash-latest, gemini-3.8-flash (needs paid quota)

# ==============================================
# DATABASE CONFIGURATION
# ==============================================

# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://scraper:scraper_password@postgres:5432/scraper_db

# Database pool settings (optional)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ==============================================
# REDIS CONFIGURATION
# ==============================================

# Redis connection URL
REDIS_URL=redis://redis:6379/0

# ==============================================
# API CONFIGURATION
# ==============================================

# Backend API URL (used by frontend)
BACKEND_URL=http://localhost:8000

# Frontend URL (used for CORS)
FRONTEND_URL=http://localhost:3000

# Application secret key (change this to a random string!)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change_this_to_a_random_secret_key_in_production

# API rate limiting (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=30

# ==============================================
# TIMEOUTS & LIMITS
# ==============================================

# LLM request timeout (seconds)
LLM_TIMEOUT_SECONDS=45

# Maximum LLM retry attempts
LLM_MAX_RETRIES=2

# Web scraping timeout (seconds)
SCRAPING_TIMEOUT_SECONDS=30

# Browser page load timeout (seconds)
BROWSER_TIMEOUT_SECONDS=30

# Maximum extraction job duration (minutes)
EXTRACTION_TIMEOUT_MINUTES=5

# Maximum webpage size to process (MB)
MAX_PAGE_SIZE_MB=10

# Maximum number of concurrent extraction jobs
MAX_CONCURRENT_JOBS=10

# Maximum number of records to extract per job
MAX_RECORDS_PER_JOB=1000

# ==============================================
# SECURITY SETTINGS
# ==============================================

# Enable SSRF protection (MUST be true in production)
ENABLE_SSRF_PROTECTION=true

# Allowed URL schemes (comma-separated)
ALLOWED_URL_SCHEMES=http,https

# Block private IP ranges (MUST be true in production)
BLOCK_PRIVATE_IPS=true

# Block cloud metadata endpoints (MUST be true in production)
BLOCK_CLOUD_METADATA=true

# ==============================================
# LOGGING CONFIGURATION
# ==============================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format: json or text
LOG_FORMAT=json

# ==============================================
# CELERY WORKER CONFIGURATION
# ==============================================

# Celery broker URL (should match REDIS_URL)
CELERY_BROKER_URL=redis://redis:6379/0

# Celery result backend
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Number of concurrent worker processes
CELERY_WORKER_CONCURRENCY=4

# Task time limit (seconds)
CELERY_TASK_TIME_LIMIT=600

# ==============================================
# DEVELOPMENT / DEBUG SETTINGS
# ==============================================

# Enable debug mode (NEVER set to true in production!)
DEBUG=false

# Enable auto-reload on code changes (development only)
RELOAD=false

# Mock LLM mode (for testing without API keys)
MOCK_LLM=false

# ==============================================
# OPTIONAL FEATURES
# ==============================================

# Enable extraction history (database storage)
ENABLE_HISTORY=true

# History retention days (0 = keep forever)
HISTORY_RETENTION_DAYS=90

# Enable detailed extraction metrics
ENABLE_METRICS=true

# ==============================================
# NOTES
# ==============================================
# 1. Get Groq API key: https://console.groq.com/
# 2. Get Gemini API key: https://aistudio.google.com/app/apikey
# 3. Change SECRET_KEY to a secure random value
# 4. Keep SSRF protection enabled in production
# 5. Adjust timeouts based on your needs
# 6. Monitor LLM usage to avoid unexpected costs
